          "_name": "gallery10",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"gallery10\" group=\"Gallery\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n    \n    <header>Animated Text Settings</header>\n    <select title=\"Font style\" name=\"linesTitle\">\n      <option value=\"title1\" selected>Title 1</option>\n      <option value=\"title2\">Title 2</option>\n    </select>\n    <input type=\"text\" title=\"Line content 1 <br> (For the best experience, please write at least 100 characters)\" inline=\"\" name=\"animatedLine1\" value=\"☁️ Best offers ☁️ Free delivery ☁️ Perfect design ☁️ Comfort ☁️ Support 24/7 ☁️ Vibes\">\n    <input type=\"range\" inline title=\"Line speed\" name=\"speed\" min=\"0.01\" max=\"0.09\" step=\"0.01\" value=\"0.05\">\n    <select title=\"Direction\" name=\"direction\">\n      <option value=\"-1\" selected>Left</option>\n      <option value=\"1\">Right</option>\n    </select>\n    <input type=\"color\" title=\"Content color\" value=\"#232323\" name=\"contentColor\" selected>\n    <header>Background</header>\n    <fieldset type=\"background\" parallax name=\"bg\" required>\n      <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n      <input type=\"color\" title=\"Color\" value=\"#ffa25b\" selected>\n    </fieldset>\n    <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n    <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f7f7f7\" condition=\"overlay && bg.type !== 'color'\">\n    <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n</mbr-parameters>\n\n<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n</div>\n  <div class=\"container-fluid\">\n\n      <div class=\"loop-container\">\n        <div class=\"item\" mbr-class=\"{'display-1':linesTitle=='title1','display-2':linesTitle=='title2'}\" data-linewords=\"{{animatedLine1}}\" data-direction=\"{{direction}}\" data-speed=\"{{speed}}\">☁️ Best offers ☁️ Free delivery ☁️ Perfect design ☁️ Comfort ☁️ Support 24/7 ☁️ Vibes</div>\n        <div class=\"item\" mbr-class=\"{'display-1':linesTitle=='title1','display-2':linesTitle=='title2'}\" data-linewords=\"{{animatedLine1}}\" data-direction=\"{{direction}}\" data-speed=\"{{speed}}\">☁️ Best offers ☁️ Free delivery ☁️ Perfect design ☁️ Comfort ☁️ Support 24/7 ☁️ Vibes</div>\n      </div>\n    \n  </div>\n</section>",
          "_cid": "uE2ZFh8fds",
          "_anchor": "gallery10-1t",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            ".item:focus, span:focus": {
              "outline": "none"
            },
            ".item": {
              "cursor": "pointer"
            },
            ".container-fluid": {
              "padding-left": "0",
              "padding-right": "0",
              "overflow": "hidden"
            },
            ".content-head": {
              "max-width": "800px"
            },
            "@keyframes ticker": {
              "0%": {
                "transform": "translate3d(0, 0, 0)",
                "visibility": "visible"
              },
              "100%": {
                "transform": "translate3d(-100%, 0, 0)"
              }
            },
            ".ticker-wrap": {
              "width": "100%",
              "overflow": "hidden",
              "padding-left": "100%",
              "box-sizing": "content-box",
              ".ticker": {
                "display": "inline-block",
                "line-height": "4rem",
                "white-space": "nowrap",
                "padding-right": "100%",
                "box-sizing": "content-box",
                "animation-iteration-count": "infinite",
                "animation-timing-function": "linear",
                "animation-name": "ticker",
                "animation-duration": "(@durationTopLine * 1s)",
                "&__item": {
                  "display": "inline-block",
                  "padding": "0 2rem",
                  "color": "@contentColor"
                }
              },
              "@keyframes ticker__center": {
                "0%": {
                  "transform": "translate3d(0, 0, 0)",
                  "visibility": "visible"
                },
                "100%": {
                  "transform": "translate3d(-100%, 0, 0)"
                }
              },
              ".ticker__center": {
                "display": "inline-block",
                "line-height": "4rem",
                "white-space": "nowrap",
                "padding-right": "100%",
                "box-sizing": "content-box",
                "animation-iteration-count": "infinite",
                "animation-timing-function": "linear",
                "animation-name": "ticker__center",
                "animation-duration": "(@durationCenterLine * 1s)"
              },
              "@keyframes ticker__end": {
                "0%": {
                  "transform": "translate3d(0, 0, 0)",
                  "visibility": "visible"
                },
                "100%": {
                  "transform": "translate3d(-100%, 0, 0)"
                }
              },
              ".ticker__end": {
                "display": "inline-block",
                "line-height": "4rem",
                "white-space": "nowrap",
                "padding-right": "100%",
                "box-sizing": "content-box",
                "animation-iteration-count": "infinite",
                "animation-timing-function": "linear",
                "animation-name": "ticker__end",
                "animation-duration": "(@durationEndLine * 1s)"
              }
            },
            ".mbr-section-title, .mbr-section-subtitle": {
              "color": "#000000"
            }
          },
          "_name": "gallery08",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"gallery08\" group=\"Gallery\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"6\">\n    \n    <header>Animated Text Settings</header>\n    <select title=\"Font style\" name=\"linesTitle\">\n      <option value=\"title1\" selected>Title 1</option>\n      <option value=\"title2\">Title 2</option>\n      <option value=\"title3\">Title 3</option>\n      <option value=\"text\">Text</option>\n      <option value=\"menu\">Menu</option>\n    </select>\n    <input type=\"text\" title=\"Line content 1\" inline name=\"animatedLine1\" value=\"Dream • Create • Inspire\">\n    <input type=\"text\" title=\"Line content 2\" inline name=\"animatedLine2\" value=\"From idea to reality • Start small\">\n    <input type=\"text\" title=\"Line content 3\" inline name=\"animatedLine3\" value=\"Be fearless • Start now!\">\n    <input type=\"range\" inline title=\"Line 1 duration\" name=\"durationTopLine\" min=\"1\" max=\"40\" step=\"1\" value=\"20\">\n    <input type=\"range\" inline title=\"Line 2 duration\" name=\"durationCenterLine\" min=\"1\" max=\"40\" step=\"1\" value=\"25\">\n    <input type=\"range\" inline title=\"Line 3 duration\" name=\"durationEndLine\" min=\"1\" max=\"40\" step=\"1\" value=\"18\">\n    <input type=\"color\" title=\"Content color\" value=\"#232323\" name=\"contentColor\" selected>\n    <header>Background</header>\n    <fieldset type=\"background\" parallax name=\"bg\" required>\n      <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n      <input type=\"color\" title=\"Color\" value=\"#4f66e6\" selected>\n    </fieldset>\n    <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n    <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f7f7f7\" condition=\"overlay && bg.type !== 'color'\">\n    <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n</mbr-parameters>\n\n<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n</div>\n  <div class=\"container-fluid gallery-wrapper\">\n\n    <div class=\"ticker-wrap\">\n      <div class=\"ticker\">\n        <div class=\"ticker__item\" mbr-class=\"{'display-1':linesTitle=='title1','display-2':linesTitle=='title2',\n        'display-5':linesTitle=='title3','display-7':linesTitle=='text',\n        'display-4':linesTitle=='menu'}\" data-word=\"{{animatedLine1}}\">Dream • Create • Inspire\n        </div>\n      </div>\n    </div>\n\n    <div class=\"ticker-wrap\">\n      <div class=\"ticker ticker__center\">\n        <div class=\"ticker__item\" mbr-class=\"{'display-1':linesTitle=='title1','display-2':linesTitle=='title2',\n        'display-5':linesTitle=='title3','display-7':linesTitle=='text',\n        'display-4':linesTitle=='menu'}\" data-word=\"{{animatedLine2}}\">From idea to reality • Start small\n        </div>\n      </div>\n    </div>\n\n    <div class=\"ticker-wrap\">\n      <div class=\"ticker ticker__end\">\n        <div class=\"ticker__item\" mbr-class=\"{'display-1':linesTitle=='title1','display-2':linesTitle=='title2',\n        'display-5':linesTitle=='title3','display-7':linesTitle=='text',\n        'display-4':linesTitle=='menu'}\" data-word=\"{{animatedLine3}}\">Be fearless • Start now!\n        </div>\n      </div>\n    </div>\n  </div>\n</section>",
          "_cid": "uE2ZFhpogb",
          "_anchor": "gallery08-1u",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        }
      ]
    }
  }
}